# =============================================================================
# Root Environment Configuration Template (.env.example)
# Simple To-Do Application with AWS Packer Golden Image Support
# =============================================================================

# Server Settings
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# MySQL 8 Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=todo_application
DB_USER=todo_user
DB_PASSWORD=your_secure_database_password_here
DB_CONNECTION_LIMIT=10

# Security & JWT Secrets (Do NOT use these defaults in production!)
JWT_SECRET=replace_with_cryptographically_secure_random_key_64_chars_min
JWT_EXPIRES_IN=24h
COOKIE_SECURE=false

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# AWS SSM Parameter Store flag (used by first-boot bootstrap script if enabled)
USE_AWS_SSM=false
SSM_PARAM_PREFIX=/todo-app/prod
AWS_REGION=us-east-1
