# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=todo_application
DB_USER=todo_user
DB_PASSWORD=change_this_to_a_secure_db_password
DB_CONNECTION_LIMIT=10

# Security & Authentication
# Generate a strong 64-character secret using: openssl rand -hex 32
JWT_SECRET=change_this_to_a_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=24h
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
